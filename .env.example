# NASA ADS API Token
# Get your token from: https://ui.adsabs.harvard.edu/user/settings/token
ADS_API_TOKEN=your_token_here

# Optional: also write a log file (useful when debugging disconnects)
# Optional log file: one line per start (version, process ID) and stop; capped at ~1 MB
# NASA_ADS_LOG_FILE=~/nasa-ads-mcp.log
